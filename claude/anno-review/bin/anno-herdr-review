#!/usr/bin/env bash
# Opens anno in a new Herdr tab, waits for the reviewer to quit, and prints
# anno's agent export to stdout.
set -euo pipefail

usage() {
	cat <<USAGE
Usage: anno-herdr-review [options] <file>
       anno-herdr-review [options] --stdin [--name <file-name>]

Open anno in a new Herdr tab, block until the reviewer exits, then print
anno's agent export to stdout. The tab closes when anno exits, and focus
returns to the tab that started the review.

Options:
  --stdin             Review text read from stdin instead of a file
  --name <file-name>  File name for --stdin content (default: review.md)
  --syntax <syntax>   Syntax hint for highlighting
  --title <title>     Title shown in anno's status bar
  -h, --help          Show this help message

Exit codes:
  0  Review exported (stdout holds the agent export)
  1  Missing dependencies, missing file, or the review tab failed
  2  Invalid arguments
  3  Reviewer quit without exporting (for example with :q!)
USAGE
}

fail() {
	echo "anno-herdr-review: $*" >&2
	exit 1
}

RUNNER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/anno-tab-runner"
FROM_STDIN=0
NAME="review.md"
SYNTAX=""
TITLE=""
FILE=""

while [[ $# -gt 0 ]]; do
	case "$1" in
	--stdin)
		FROM_STDIN=1
		shift
		;;
	--name | --syntax | --title)
		[[ $# -ge 2 ]] || {
			echo "Missing value for $1" >&2
			exit 2
		}
		case "$1" in
		--name) NAME="$2" ;;
		--syntax) SYNTAX="$2" ;;
		--title) TITLE="$2" ;;
		esac
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		[[ $# -le 1 && -z "$FILE" ]] || {
			echo "Only one file can be reviewed at a time" >&2
			exit 2
		}
		FILE="${1:-}"
		shift $#
		;;
	-*)
		echo "Unknown option: $1" >&2
		usage >&2
		exit 2
		;;
	*)
		[[ -z "$FILE" ]] || {
			echo "Only one file can be reviewed at a time" >&2
			exit 2
		}
		FILE="$1"
		shift
		;;
	esac
done

if [[ "$FROM_STDIN" == 1 && -n "$FILE" ]]; then
	echo "Pass either a file or --stdin, not both" >&2
	exit 2
fi
if [[ "$FROM_STDIN" == 0 && -z "$FILE" ]]; then
	usage >&2
	exit 2
fi

# ── Check dependencies ────────────────────────────────────────────────
[[ "${HERDR_ENV:-}" == 1 ]] || fail "not running inside a Herdr pane"
command -v herdr >/dev/null 2>&1 || fail "herdr not found on PATH"
ANNO_BIN="$(command -v anno 2>/dev/null)" || fail "anno not found on PATH"

# ── Prepare the review file ───────────────────────────────────────────
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/anno-herdr-review.XXXXXX")"
REVIEW_TAB=""

cleanup() {
	if [[ -n "$REVIEW_TAB" ]]; then
		# The tab normally closes itself when anno exits; this covers failures.
		herdr tab close "$REVIEW_TAB" >/dev/null 2>&1 || true
		[[ -z "${HERDR_TAB_ID:-}" ]] || herdr tab focus "$HERDR_TAB_ID" >/dev/null 2>&1 || true
	fi
	rm -rf "$WORK_DIR"
}
trap cleanup EXIT

if [[ "$FROM_STDIN" == 1 ]]; then
	REVIEW_FILE="$WORK_DIR/$(basename "$NAME")"
	cat >"$REVIEW_FILE"
else
	[[ -f "$FILE" ]] || fail "file not found: $FILE"
	REVIEW_FILE="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"
fi

[[ -n "$TITLE" ]] || TITLE="Reviewing: $(basename "$REVIEW_FILE")"

OUTPUT_FILE="$WORK_DIR/annotations.agent"
DONE_FILE="$WORK_DIR/done"

# ── Open the review tab and wait ──────────────────────────────────────
create_args=(
	tab create
	--cwd "$PWD"
	--label anno
	--focus
	--env "ANNO_BIN=$ANNO_BIN"
	--env "ANNO_REVIEW_RUNNER=$RUNNER"
	--env "ANNO_REVIEW_FILE=$REVIEW_FILE"
	--env "ANNO_REVIEW_OUTPUT=$OUTPUT_FILE"
	--env "ANNO_REVIEW_DONE=$DONE_FILE"
	--env "ANNO_REVIEW_TITLE=$TITLE"
)
[[ -z "$SYNTAX" ]] || create_args+=(--env "ANNO_REVIEW_SYNTAX=$SYNTAX")
[[ -z "${HERDR_WORKSPACE_ID:-}" ]] || create_args+=(--workspace "$HERDR_WORKSPACE_ID")

created="$(herdr "${create_args[@]}")" || fail "Herdr could not open a review tab"
# The new tab and its root pane share one tab_id, and only the pane has a
# pane_id, so the first match of each is unambiguous.
REVIEW_TAB="$(grep -o '"tab_id":"[^"]*"' <<<"$created" | head -1 | cut -d'"' -f4)"
REVIEW_PANE="$(grep -o '"pane_id":"[^"]*"' <<<"$created" | head -1 | cut -d'"' -f4)"
[[ -n "$REVIEW_TAB" && -n "$REVIEW_PANE" ]] || fail "could not read the review tab from Herdr's response"

# The tab starts the user's login shell; replace it with the runner so the
# tab closes on its own when anno exits. Every value travels in the tab's
# environment, so nothing needs shell quoting. The leading space keeps the
# command out of shell history where the shell honors that.
herdr pane run "$REVIEW_PANE" ' exec "$ANNO_REVIEW_RUNNER"' >/dev/null ||
	fail "Herdr could not start anno in the review tab"

# The runner writes done.started as soon as it runs; shells can be slow to
# start, so allow a generous window.
for _ in $(seq 1 150); do
	[[ -e "$DONE_FILE.started" || -e "$DONE_FILE" ]] && break
	sleep 0.1
done
[[ -e "$DONE_FILE.started" || -e "$DONE_FILE" ]] || fail "anno did not start in the review tab"

RUNNER_PID="$(cat "$DONE_FILE.started" 2>/dev/null || true)"
until [[ -e "$DONE_FILE" ]]; do
	if [[ -n "$RUNNER_PID" ]] && ! kill -0 "$RUNNER_PID" 2>/dev/null; then
		# The runner may have finished between the two checks.
		[[ -e "$DONE_FILE" ]] && break
		fail "the anno review tab closed unexpectedly"
	fi
	sleep 0.2
done

STATUS="$(cat "$DONE_FILE")"
if [[ -s "$OUTPUT_FILE" ]]; then
	cat "$OUTPUT_FILE"
	exit 0
fi
if [[ "$STATUS" == 0 ]]; then
	echo "anno-herdr-review: reviewer quit without exporting annotations" >&2
	exit 3
fi
fail "anno exited with status $STATUS before exporting annotations"
